datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Era {
  YEARS_OF_THE_TREES
  FIRST_AGE
  SECOND_AGE
  THIRD_AGE
}

model Creature {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  originEra   Era      @default(THIRD_AGE)
  master      String?
  threatLevel String
  description String   @db.Text
  createdAt   DateTime @default(now())

  notables NotableBeast[]
  habitats CreatureHabitat[]

  @@map("creatures")
}

model NotableBeast {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  title      String?
  status     String
  creatureId Int
  creature   Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  @@map("notable_beasts")
}

model Habitat {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  description String?           @db.Text
  creatures   CreatureHabitat[]

  @@map("habitats")
}

model CreatureHabitat {
  creatureId Int
  habitatId  Int
  creature   Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  habitat    Habitat  @relation(fields: [habitatId], references: [id], onDelete: Cascade)

  @@id([creatureId, habitatId])
  @@map("creature_habitats")
}
